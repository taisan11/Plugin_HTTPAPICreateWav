<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <OutputType>Library</OutputType>
    <Platforms>AnyCPU;x86</Platforms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CodePage>65001</CodePage>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <BouyomiChanPath Condition="'$(BouyomiChanPath)' == ''">$(MSBuildProjectDirectory)\..\lib\BouyomiChan.exe</BouyomiChanPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <DefineConstants />
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Lib.Harmony" Version="2.3.5" />
    <Reference Include="BouyomiChan">
      <HintPath>$(BouyomiChanPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <Target Name="ValidateBouyomiChanPath" BeforeTargets="ResolveAssemblyReferences" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(BouyomiChanPath)')"
           Text="BouyomiChan.exe が見つかりません。lib\BouyomiChan.exe に配置するか、-p:BouyomiChanPath=&quot;C:\path\to\BouyomiChan.exe&quot; を指定してください。現在の参照先: $(BouyomiChanPath)" />
  </Target>
</Project>
